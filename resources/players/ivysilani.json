{
      "name": "iVysílání",
      "plugin": "plugin.video.ivysilani.cz",
      "priority": 100,
      "is_resolvable": "true",
      "language": true,
      "assert": {
          "play_movie":     ["title"],
          "play_episode":   ["showname", "title"],
          "search_movie":   ["title"],
          "search_episode": ["showname", "title"]
      },
      "search_movie": [
          "plugin://plugin.video.ivysilani.cz/?action=program_search&query={cs_title_url}&label=TMDbHelper&page=1",
          {"strict": "true", "dialog": "auto", "label": "(?i).*{cs_title}.*"}
      ],
      "search_episode": [
          "plugin://plugin.video.ivysilani.cz/?action=program_search&query={cs_showname_url}%20{cs_title_url}&label=TMDbHelper&page=1",
          {"return": "true", "strict": "true", "dialog": "auto", "label": "(?i).*{cs_showname}.*"},
          {"strict": "true", "dialog": "auto", "label": "(?i).*{cs_title}.*"}
      ]
  }