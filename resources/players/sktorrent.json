{
    "name": "SKTorrent",
    "plugin": "plugin.video.sktorrent",
    "priority": 200,
    "is_resolvable": "true",
    "language": true,
    "assert": {
        "play_movie":     ["title", "year"],
        "search_movie":   ["title", "year"],
        "play_episode":   ["showname"],
        "search_episode": ["showname"]
    },
    "search_movie":   ["plugin://plugin.video.sktorrent/?action=search&query={ask_cs_title_url} {year}", {"dialog": "auto"}],
    "search_episode": ["plugin://plugin.video.sktorrent/?action=search&query={ask_cs_showname_url}", {"dialog": "auto"}]
}
